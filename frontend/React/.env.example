# 開発サーバーは localhost:3000 か localhost:5173 で起動する(地図のキーがこの2つだけを許可している)
# API キー2つは値を空にしてある。README の手順で取得して .env に書く

# Google Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=a1a1763c1a11a341d706c15f

# Firebase(Web アプリ hack26-web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hack26-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hack26-project
VITE_FIREBASE_STORAGE_BUCKET=hack26-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=337647265808
VITE_FIREBASE_APP_ID=1:337647265808:web:e854fa3e8c36193998c295

# 管理者API(機能D)
# Firebase の API キーが入っていれば管理画面は本物のログインとAPIを使う。空ならサンプルデータで表示する
# 開発中は /api を下の FastAPI に転送する(未設定なら http://127.0.0.1:8000)
VITE_API_PROXY=
